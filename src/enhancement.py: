from pathlib import Path
import cv2
import numpy as np
import pandas as pd

IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp"}


def gamma_correction(rgb: np.ndarray, gamma: float = 0.7) -> np.ndarray:
  """Apply power-law (gamma < 1) correction on an RGB uint8 image."""
  if gamma <= 0:
    raise ValueError("gamma must be greater than 0.")
  if abs(gamma - 1.0) < 1e-6:
    return rgb.copy()

  inv_gamma = 1.0 / gamma
  lut = np.clip(
      np.power(np.linspace(0.0, 1.0, 256), inv_gamma) * 255.0, 0, 255
  ).astype(np.uint8)
  return cv2.LUT(rgb, lut)


def clahe_luminance(
    rgb: np.ndarray,
    clip_limit: float = 2.0,
    tile_grid_size: tuple[int, int] = (8, 8),
) -> np.ndarray:
  """Apply CLAHE on the L channel of LAB color space to preserve color balance."""
  lab = cv2.cvtColor(rgb, cv2.COLOR_RGB2LAB)
  l_ch, a_ch, b_ch = cv2.split(lab)
  clahe = cv2.createCLAHE(clipLimit=clip_limit, tileGridSize=tile_grid_size)
  l_enhanced = clahe.apply(l_ch)
  return cv2.cvtColor(cv2.merge((l_enhanced, a_ch, b_ch)), cv2.COLOR_LAB2RGB)


def enhance_image(
    rgb: np.ndarray,
    gamma: float = 0.7,
    use_clahe: bool = True,
    clip_limit: float = 2.0,
    tile_grid_size: tuple[int, int] = (8, 8),
) -> np.ndarray:
  """Enhance an RGB leaf image using Gamma correction followed by LAB CLAHE."""
  enhanced = gamma_correction(rgb, gamma=gamma)
  if use_clahe:
    enhanced = clahe_luminance(
        enhanced, clip_limit=clip_limit, tile_grid_size=tile_grid_size
    )
  return enhanced


def enhance_split_from_csv(
    split_csv: Path,
    orig_root: Path,
    out_root: Path,
    split_name: str = "val",
    gamma: float = 0.7,
    use_clahe: bool = True,
    clip_limit: float = 2.0,
    tile_grid_size: tuple[int, int] = (8, 8),
) -> int:
  """Enhance images belonging to `split_name` from `orig_root` and save them."""
  df = pd.read_csv(split_csv)
  sub = df[df["split"].astype(str).str.lower() == split_name.lower()]

  by_rel: dict[str, Path] = {}
  by_name: dict[str, Path] = {}
  for p in orig_root.rglob("*"):
    if p.is_file() and p.suffix.lower() in IMAGE_EXTS:
      rel = str(p.relative_to(orig_root)).replace("\\", "/")
      by_rel[rel] = p
      by_name.setdefault(p.name, p)

  saved_count = 0
  for rel_img in sub["image"].astype(str):
    rel_clean = rel_img.strip().lstrip("./")
    src_path = by_rel.get(rel_clean) or by_name.get(Path(rel_clean).name)
    if src_path is None:
      continue

    bgr = cv2.imread(str(src_path))
    if bgr is None:
      continue

    rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
    out_rgb = enhance_image(
        rgb,
        gamma=gamma,
        use_clahe=use_clahe,
        clip_limit=clip_limit,
        tile_grid_size=tile_grid_size,
    )
    out_bgr = cv2.cvtColor(out_rgb, cv2.COLOR_RGB2BGR)

    dst_path = out_root / split_name / rel_clean
    dst_path.parent.mkdir(parents=True, exist_ok=True)
    cv2.imwrite(str(dst_path), out_bgr)
    saved_count += 1

  return saved_count


def only_laplacian(rgb: np.ndarray, weight: float = 0.4) -> np.ndarray:
  lap = cv2.Laplacian(rgb, cv2.CV_32F, ksize=3)
  out = rgb.astype(np.float32) - weight * lap
  return np.clip(out, 0, 255).astype(np.uint8)


def only_highpass(
    rgb: np.ndarray, sigma: float = 3.0, amount: float = 0.8
) -> np.ndarray:
  low_pass = cv2.GaussianBlur(rgb, (0, 0), sigmaX=sigma, sigmaY=sigma).astype(
      np.float32
  )
  high_pass = rgb.astype(np.float32) - low_pass
  out = rgb.astype(np.float32) + amount * high_pass
  return np.clip(out, 0, 255).astype(np.uint8)


def only_gaussian(
    rgb: np.ndarray, ksize: tuple[int, int] = (5, 5), sigma: float = 1.2
) -> np.ndarray:
  return cv2.GaussianBlur(rgb, ksize, sigmaX=sigma, sigmaY=sigma)


def only_median(rgb: np.ndarray, ksize: int = 5) -> np.ndarray:
  return cv2.medianBlur(rgb, ksize)


def luma_stats(rgb: np.ndarray) -> tuple[float, float]:
  gray = cv2.cvtColor(rgb, cv2.COLOR_RGB2GRAY)
  return float(gray.mean()), float(gray.std())
